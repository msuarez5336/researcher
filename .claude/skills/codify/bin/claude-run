#!/usr/bin/env bash
# claude-run: run a skill unattended, on a small model, with hard limits, and fail loudly.
#
#   claude-run [-m model] [-t max_turns] [-b max_usd] [-j schema.json] <skill> [args...]
#
# Defaults: Haiku, 8 turns, $0.50 (a client-side estimate; it can be exceeded).
# -j: validate the answer against a JSON Schema file and print it as JSON (structured_output).
# Prints the result on stdout; cost, turns and permission denials on stderr.
# Exits non-zero if the run errored or any tool call was denied: claude -p can exit 0
# with "subtype": "success" even when calls were denied (code.claude.com/docs/en/headless
# lists them in permission_denials; a third-party test confirmed the exit code).
# Needs: claude, jq.
set -uo pipefail

usage() { sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 2; }

model=haiku turns=8 budget=0.50 schema=""
while getopts "m:t:b:j:h" o; do
  case $o in m) model=$OPTARG ;; t) turns=$OPTARG ;; b) budget=$OPTARG ;; j) schema=$OPTARG ;; *) usage ;; esac
done
shift $((OPTIND - 1))
[ $# -ge 1 ] || usage
command -v jq >/dev/null || { echo "claude-run: jq is required" >&2; exit 2; }

skill=${1#/}; shift
prompt="/$skill"
for a in "$@"; do
  if [[ $a =~ [[:space:]] ]]; then prompt+=" \"${a//\"/\\\"}\""; else prompt+=" $a"; fi
done

extra=()
[ -n "$schema" ] && extra=(--json-schema "$(cat "$schema")")
out=$(claude -p "$prompt" --model "$model" --max-turns "$turns" --max-budget-usd "$budget" \
  --permission-mode dontAsk --output-format json "${extra[@]}" </dev/null)
rc=$?

if ! jq -e . >/dev/null 2>&1 <<<"$out"; then
  echo "claude-run: no JSON result (exit $rc)" >&2
  printf '%s\n' "$out" >&2
  exit "${rc/#0/1}"
fi

if [ -n "$schema" ]; then
  jq -c '.structured_output // empty' <<<"$out"
  jq -e 'has("structured_output") and .structured_output != null' >/dev/null <<<"$out" \
    || { echo "claude-run: no structured_output in the result" >&2; rc=${rc/#0/4}; }
else
  jq -r '.result // empty' <<<"$out"
fi
jq -r '"claude-run: model='"$model"' turns=\(.num_turns // "?") cost_usd=\(.total_cost_usd // "?") (estimate)"' <<<"$out" >&2
denials=$(jq '(.permission_denials // []) | length' <<<"$out")
if [ "$denials" -gt 0 ]; then
  echo "claude-run: $denials tool call(s) denied:" >&2
  jq -c '.permission_denials[] | {tool: .tool_name, input: .tool_input}' <<<"$out" >&2
  exit 3
fi
if [ "$(jq -r '.is_error // false' <<<"$out")" = "true" ] || [ "$rc" -ne 0 ]; then
  echo "claude-run: run failed (exit $rc, subtype $(jq -r '.subtype // "?"' <<<"$out"))" >&2
  exit "${rc/#0/1}"
fi
